<!DOCTYPE html>
<html>
	<head>
		<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
		<link rel="stylesheet" href="style.css">
	</head>
	<body>
		<div class="box main-content">
			<h2 class="center">Face Recognition System</h2>
			<p class="center">v<%= version %></p>
			<div class="flexbox">
				<div class="flex box" style="margin:4px;">
					<h3 class="center">Verify</h3>
					<button class="mainPageButton" onclick="f('/registration',400,264)">Start Registration</button>
					<button class="mainPageButton" onclick="f('/verification',700,450)">Verify Identity</button>
				</div>
				<div class="flex box" style="margin:4px;">
					<h3 class="center">Records</h3>
					<button class="mainPageButton" onclick="openCurrentRecord()">Today</button>
					<button class="mainPageButton" onclick="f('/archive',400,400)">Archive</button>
				</div>
			</div>
		</div>
		<script src="update.js"></script>
		<script>
			let windows = {};
			
			function openCurrentRecord() {
				let pad = (n) => n.toString().padStart(2,"0");
	
				let now = new Date();
				let year = now.getFullYear();
				let month = pad(now.getMonth()+1);
				let day = pad(now.getDate());
				
				f(`/record?year=${year}&month=${month}&day=${day}`,400,400);
			}
			
			function f(url,w,h) {
				if (windows.hasOwnProperty(url)) {
					windows[url].focus();
				} else {
					windows[url] = window.open(url,"_blank",`width=${w},height=${h},titlebar=0,top=${(screen.height-h)/2},left=${(screen.width-w)/2}`);
					windows[url].addEventListener("unload",()=>{
						if (windows[url].location.pathname == url) {
							delete windows[url];
						}
					});
				}
			}
		</script>
	</body>
</html>