<!DOCTYPE html>
<html>
	<head>
		<title>Facial Recognition System</title>
		<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
		<link rel="stylesheet" href="style.css">
		<script src="resize-window.js"></script>
	</head>
	<body>
		<div class="box home-page-box">
			<h2 class="center">Facial Recognition System</h2>
			<p class="center">v<%= version %></p>
			<div class="gridbox">
				<div class="box flexbox">
					<iframe id="record"></iframe>
					<button class="button home-page-button" onclick="viewCurrentRecord()">View in separate window</button>
				</div>
				<div class="box">
					<button class="button home-page-button" onclick="resizeWindow('/registration')">Register</button>
					<button class="button home-page-button" onclick="resizeWindow('/verification')">Verify Identity</button>
					<button class="button home-page-button" onclick="resizeWindow('/archive')">Archive</button>
					<hr/>
					<button class="button home-page-button" onclick="resizeWindow('/qr')">QR Codes</button>
					<!-- <button class="home-page-button" onclick="f('/test',700,500)">Submit Test Images</button> -->
				</div>
				<div class="box statistics">
					<div>
						<p id="user-count">-</p>
						<p>User/s registered</p>
					</div>
				</div>
			</div>
		</div>
		<script>
			function viewCurrentRecord() {
				let src = document.getElementById("record").contentWindow;
				resizeWindow(src);
			}
		
			function update() {
				// today's attendance record
				let pad = n=>n.toString().padStart(2,"0");
		
				let now = new Date();
				let year = now.getFullYear();
				let month = pad(now.getMonth()+1);
				let day = pad(now.getDate());
				
				let newUrl = `/record?year=${year}&month=${month}&day=${day}&embedded=true`;
				if (document.getElementById("record").src != newUrl) {
					document.getElementById("record").src = newUrl;
				}
				
				// statistics
				fetch("/",{
					method: "POST",
					headers: {"Content-Type": "application/json"},
					body: JSON.stringify({action: "get registered users"})
				})
				.then(res=>res.json())
				.then(registeredUsers=>document.getElementById("user-count").innerHTML = registeredUsers.length)
				.catch(()=>document.getElementById("user-count").innerHTML = "Error");
			}
			
			function initWebSocket() {
				let socket = new WebSocket(window.location.origin);
				socket.onopen = ()=>console.log("WebSocket is open");
				socket.onclose = ()=>{
					if (confirm("WebSocket closed possibly due to server changes. Click \"OK\" to reload.")) {
						window.location.reload();
					}
				};
				
				socket.onmessage = data=>{
					console.log("Message received:",data.toString());
					update();
				};
			}
			
			update();
			initWebSocket();
		</script>
	</body>
</html>