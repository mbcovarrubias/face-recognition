<!DOCTYPE html>
<html>
	<head>
		<title>Registration</title>
		<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
		<link rel="stylesheet" href="style.css">
	</head>
	<body>
		<div class="box registration-box1">
			<h3 class="center">Registration</h3>
			<form name="registration" action="/" method="post" id="regForm" onsubmit="window.resizeTo(700,470); window.moveTo((screen.width-700)/2,(screen.height-470)/2);">
				<input type="hidden" name="action" id="action" value="camera">
				<input type="text" name="name" id="name" placeholder="Name" autocomplete="off" required>
				<input type="email" name="email" id="email" placeholder="Parent / Guardian's Email" autocomplete="off" required>
				<input type="checkbox" id="dataPrivacy" required>
				<label for="dataPrivacy">By clicking "Next", you assure that your data (name, email, facial images) will be kept confidentially.</label>
				<hr/>
				<button type="submit" id="next" disabled>Next</button>
				<button type="button" class="button" onclick="window.close();">Back to Home</button>
			</form>
			<script>
				const invalidNames = ["unknown"];
				
				async function update() {
					try {
						const response = await fetch("/",{
							method: "POST",
							headers: {
								"Content-Type": "application/json"
							},
							body: JSON.stringify({
								action: "check username",
								message: document.getElementById("name").value
							})
						});
						
						const result = await response.json();
						let a = result.alreadyExists;
						let b = document.getElementById("name").value.trim() != document.getElementById("name").value;
						let c = !document.getElementById("dataPrivacy").checked;
						let d = invalidNames.includes(document.getElementById("name").value);
						let e = document.getElementById("name").value.trim() == "";
						
						document.getElementById("next").disabled = a||b||c||d||e;
						document.getElementById("next").innerHTML = a ? "User already exists" : (d ? "Invalid name" : "Next");
					} catch (err) {
						console.error(err);
					}
				}
				
				document.getElementById("name").addEventListener("keyup",update);
				document.getElementById("dataPrivacy").addEventListener("change",update);
			</script>
		</div>
	</body>
</html>