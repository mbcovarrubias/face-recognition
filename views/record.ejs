<!DOCTYPE html>
<html>
	<head>
		<link rel="stylesheet" href="style.css">
	</head>
	<body>
		<div class="box" id="box">
			<h2 class="center"><%= date %></h2>
			<table class="records">
				<tbody id="recordsTableBody">
					<tr>
						<th>Name</th>
						<th>Time</th>
					</tr>
				</tbody>
			</table>
			<button class="button" onclick="window.location.href = window.location.origin + '/archive'">Archive</button>
		</div>
		<script>
			let records = <%- record %>;
			records.forEach(row=>{
				let tr = document.createElement("tr");
				Object.values(row).forEach((val)=>{
					let td = document.createElement("td");
					td.innerHTML = val;
					tr.appendChild(td);
				});
				document.getElementById("recordsTableBody").appendChild(tr);
			})
		</script>
	</body>
</html>