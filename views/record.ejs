<!DOCTYPE html>
<html>
	<head>
		<link rel="stylesheet" href="style.css">
	</head>
	<body>
		<div class="box">
			<h2 class="center"><%= date %></h2>
			<input type="text" class="searchbar" id="searchbar" placeholder="Search" />
			<table class="records">
				<tbody id="recordsTableBody">
					<tr class="header">
						<th>Name</th>
						<th>Time</th>
					</tr>
				</tbody>
			</table>
			<button class="button" onclick="window.location.href = window.location.origin + '/archive'">Archive</button>
		</div>
		<script>
			let records = <%- record %>;
			let rowElements = [];
			
			function update() {
				rowElements.forEach(row=>row.remove());
				
				let keyword = document.getElementById("searchbar").value.toLowerCase();
				
				records.forEach(row=>{
					if (row.name.toLowerCase().startsWith(keyword)) {
						let tr = document.createElement("tr");
						tr.id = row.name
						Object.values(row).forEach((val)=>{
							let td = document.createElement("td");
							td.innerHTML = val;
							tr.appendChild(td);
						});
						document.getElementById("recordsTableBody").appendChild(tr);
						rowElements.push(tr);
					}
				})
			}

			document.getElementById("searchbar").addEventListener("change",update);
			update();
		</script>
	</body>
</html>