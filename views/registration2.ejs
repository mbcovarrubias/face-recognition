<!DOCTYPE html>
<html lang="en">
	<head>
		<title>Registration</title>
		<link rel="stylesheet" href="style.css">
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<script src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.11.9/p5.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.15/dist/face-api.js"></script>
		<script src="resize-window.js"></script>
	</head>
	<body>
		<div class="box registration-box2" style="margin:auto;">
			<h3 class="center">Registration</h3>
			<form name="camera" method="post" id="cameraForm" action="/registration" onsubmit="resizeWindow('/registration','regfinish','_self')">
				<div class="gridbox" style="width:100%; grid-template-rows: 1fr;">
					<div class="box" id="canvas">
						<div class="center">
							<!-- create main element here so p5.js will use it here instead of creating it by itself in the body-->
							<main>
							</main>
						</div>
					</div>
					<div class="box">
						<h4 class="center">Instructions</h4>
						<ol>
							<li>Click "Start Capturing" to start face detection.</li>
							<li>Face different directions slightly off from the camera.</li>
							<li>Once done capturing, click "Next" to finish registration.</li>
						</ol>
						<hr/>
						<p id="captures">Faces captured: N/A</p>
						<p id="face">Detecting face: N/A</p>
						<hr/>
						<button class="button" type="button" id="capture">Restart Capturing</button>
						<button class="button" type="submit" id="next" disabled>Next</button>
					</div>

					<input type="hidden" name="action" id="action" value="regfinish"> <!-- for submitting form to server -->
					<input type="hidden" name="name" id="name" value="<%= name %>">
					<!-- <input type="hidden" name="email" id="email" value="<#= email %>"> -->
					
					<script src="camera.js"></script>
				</div>
			</form>
		</div>
	</body>

</html>
